{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://infra.convee.io/schemas/v1alpha1/version-lock.schema.json",
  "title": "infra VersionLock",
  "type": "object",
  "required": ["apiVersion", "kind", "spec"],
  "additionalProperties": false,
  "properties": {
    "apiVersion": {"const": "infra.convee.io/v1alpha1"},
    "kind": {"const": "VersionLock"},
    "spec": {
      "type": "object",
      "required": ["packages"],
      "additionalProperties": false,
      "properties": {
        "packages": {
          "type": "object",
          "additionalProperties": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "version": {"type": "string", "minLength": 1},
              "digest": {"type": "string", "pattern": "^sha256:[a-f0-9]{64}$"},
              "revision": {"type": "string", "pattern": "^[a-f0-9]{40}$"},
              "values": {"type": "object"}
            },
            "anyOf": [
              {"required": ["digest"]},
              {"required": ["revision"]},
              {"required": ["version"]}
            ]
          }
        }
      }
    }
  }
}
